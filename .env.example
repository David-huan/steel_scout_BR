# Server
HOST=127.0.0.1
PORT=8000

# Storage
DATABASE_PATH=./data/steel.db
DATA_DIR=./data

# Discovery (optional). Without keys the app uses the curated BR seed.
SERPER_API_KEY=
SERPER_MAX_QUERIES=6
GOOGLE_MAPS_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Crawling
CRAWL_LIVE=true
CRAWL_MAX_PAGES=2
CRAWL_THREADS=6
HTTP_TIMEOUT=8
MAX_QUERIES=40
MAX_SITES=120
USER_AGENT=YIEH-CustomerResearchBot/1.0 (+https://www.yieh.com; research-only)
